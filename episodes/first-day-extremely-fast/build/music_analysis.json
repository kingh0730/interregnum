  "lyrics": [
    {
      "id": "L01",
      "start": 0.0,
      "frame_60fps": 0,
      "text": "你说活在明天活在期待",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 2.84
    },
    {
      "id": "L02",
      "start": 2.84,
      "frame_60fps": 170,
      "text": "不如活得今天很自在",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 5.23
    },
    {
      "id": "L03",
      "start": 5.23,
      "frame_60fps": 314,
      "text": "我说我懂了会不会太快",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 8.24
    },
    {
      "id": "L04",
      "start": 8.24,
      "frame_60fps": 494,
      "text": "未来第一天要展开",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 11.92
    },
    {
      "id": "L05",
      "start": 11.92,
      "frame_60fps": 715,
      "text": "第一天我存在",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 14.64
    },
    {
      "id": "L06",
      "start": 14.64,
      "frame_60fps": 878,
      "text": "第一次呼吸畅快",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 17.61
    },
    {
      "id": "L07",
      "start": 17.61,
      "frame_60fps": 1057,
      "text": "站在地上的脚踝",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 19.67
    },
    {
      "id": "L08",
      "start": 19.67,
      "frame_60fps": 1180,
      "text": "因为你而有真实感",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 22.7
    },
    {
      "id": "L09",
      "start": 22.7,
      "frame_60fps": 1362,
      "text": "第一天我存在",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 25.45
    },
    {
      "id": "L10",
      "start": 25.45,
      "frame_60fps": 1527,
      "text": "第一次能飞起来",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 28.55
    },
    {
      "id": "L11",
      "start": 28.55,
      "frame_60fps": 1713,
      "text": "爱是腾空的魔幻",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 30.68
    },
    {
      "id": "L12",
      "start": 30.68,
      "frame_60fps": 1841,
      "text": "第一天的纯真色彩它总是",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 34.21
    },
    {
      "id": "L13",
      "start": 34.21,
      "frame_60fps": 2053,
      "text": "永远那么灿烂",
      "timing_source": "supplied LRC; line-level, not phoneme-aligned",
      "end": 37.07
    },
    {
      "id": "L14",
      "start": 37.07,
